# ===================================================
# IntelliNote AI — Environment Configuration Example
# ===================================================

# Application Server
HOST=127.0.0.1
PORT=8765

# Local Storage
DB_PATH=data/intellinote.db
BACKUP_DIR=data/backups
EXPORT_DIR=data/exports

# Local AI Models (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Offline Speech Recognition (whisper.cpp)
WHISPER_MODEL=base
WHISPER_CPP_PATH=

# Sandboxed Execution Security Limits
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_OUTPUT_BYTES=65536
CATEGORIZATION_CONFIDENCE_THRESHOLD=0.40
